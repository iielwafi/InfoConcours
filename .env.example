APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///infoconcours.db
COOKIE_SECURE=0
ADAPTIVE_THRESHOLDS=40,60,75,90
EXAM_DURATION_MINUTES=240
# Optional semantic correction for open exercises. Keep the API key server-side.
# Without OPENAI_API_KEY, open exercises remain in the teacher review queue.
EXERCISE_GRADING_PROVIDER=openai
OPENAI_API_KEY=
EXERCISE_GRADING_MODEL=gpt-4o-mini
# Optional OpenAI Responses API compatible endpoint (HTTPS only).
# EXERCISE_GRADING_API_URL=https://api.openai.com/v1/responses
